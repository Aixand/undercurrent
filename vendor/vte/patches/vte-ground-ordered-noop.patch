+#[cfg(test)]
+mod bulk_tests {
+    use super::{Params, Parser, Perform};
+    use std::vec::Vec;
+
+    #[derive(Debug, Eq, PartialEq)]
+    enum Event {
+        Print(char),
+        Execute(u8),
+        Hook(Vec<Vec<u16>>, Vec<u8>, bool, char),
+        Put(u8),
+        Unhook,
+        Osc(Vec<Vec<u8>>, bool),
+        Csi(Vec<Vec<u16>>, Vec<u8>, bool, char),
+        Esc(Vec<u8>, bool, u8),
+    }
+
+    #[derive(Default)]
+    struct Recorder(Vec<Event>);
+
+    impl Perform for Recorder {
+        fn print(&mut self, c: char) {
+            self.0.push(Event::Print(c));
+        }
+
+        fn execute(&mut self, byte: u8) {
+            self.0.push(Event::Execute(byte));
+        }
+
+        fn hook(&mut self, params: &Params, intermediates: &[u8], ignore: bool, action: char) {
+            self.0.push(Event::Hook(
+                params.iter().map(|param| param.to_vec()).collect(),
+                intermediates.to_vec(),
+                ignore,
+                action,
+            ));
+        }
+
+        fn put(&mut self, byte: u8) {
+            self.0.push(Event::Put(byte));
+        }
+
+        fn unhook(&mut self) {
+            self.0.push(Event::Unhook);
+        }
+
+        fn osc_dispatch(&mut self, params: &[&[u8]], bell_terminated: bool) {
+            self.0.push(Event::Osc(
+                params.iter().map(|param| param.to_vec()).collect(),
+                bell_terminated,
+            ));
+        }
+
+        fn csi_dispatch(
+            &mut self,
+            params: &Params,
+            intermediates: &[u8],
+            ignore: bool,
+            action: char,
+        ) {
+            self.0.push(Event::Csi(
+                params.iter().map(|param| param.to_vec()).collect(),
+                intermediates.to_vec(),
+                ignore,
+                action,
+            ));
+        }
+
+        fn esc_dispatch(&mut self, intermediates: &[u8], ignore: bool, byte: u8) {
+            self.0.push(Event::Esc(intermediates.to_vec(), ignore, byte));
+        }
+    }
+
+    #[test]
+    fn bulk_and_scalar_paths_dispatch_identically() {
+        let mut input = b"plain text \x1b[31mred\x1b[0m ".to_vec();
+        input.extend_from_slice("界🙂e\u{301}".as_bytes());
+        input.extend_from_slice(b"\x1b[m\x1b[;4m\x1b[9223372036854775808m\x1b[38:2:1:2:3m");
+        input.extend_from_slice(b"\x1b]2;title\x07\x1bP0;1|xy\x9c\x7f");
+        input.extend_from_slice(&[0xf5, 0xff, b'!']);
+
+        let mut scalar_parser = Parser::new();
+        let mut scalar = Recorder::default();
+        for byte in &input {
+            scalar_parser.advance(&mut scalar, *byte);
+        }
+
+        let mut bulk_parser = Parser::new();
+        let mut bulk = Recorder::default();
+        bulk_parser.advance_bytes(&mut bulk, &input);
+
+        assert_eq!(bulk.0, scalar.0);
+
+        let mut chunked_parser = Parser::new();
+        let mut chunked = Recorder::default();
+        for chunk in input.chunks(3) {
+            chunked_parser.advance_bytes(&mut chunked, chunk);
+        }
+
+        assert_eq!(chunked.0, scalar.0);
+    }
+}
