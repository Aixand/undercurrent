+    /// Advances the parser over a byte slice, batching valid printable text
+    /// while preserving scalar processing for controls, invalid UTF-8, and
+    /// incomplete UTF-8 sequences split across calls.
+    #[inline]
+    pub fn advance_bytes<P: Perform>(&mut self, performer: &mut P, bytes: &[u8]) {
+        let mut index = 0;
+        while index < bytes.len() {
+            if matches!(self.state, State::Ground) {
+                if let Some(consumed) = self.advance_numeric_csi(performer, &bytes[index..]) {
+                    index += consumed;
+                    continue;
+                }
+
+                let ascii_start = index;
+                while index < bytes.len() && matches!(bytes[index], 0x20..=0x7e) {
+                    index += 1;
+                }
+                if index > ascii_start {
+                    performer.print_ascii(&bytes[ascii_start..index]);
+                    continue;
+                }
+
+                if bytes[index] >= 0x80 {
+                    let text_start = index;
+                    let mut text_end = index;
+                    while text_end < bytes.len()
+                        && bytes[text_end] >= 0x20
+                        && bytes[text_end] != 0x7f
+                    {
+                        text_end += 1;
+                    }
+                    if let Err(error) = core::str::from_utf8(&bytes[text_start..text_end]) {
+                        let valid = error.valid_up_to();
+                        if valid > 0 {
+                            let text = core::str::from_utf8(&bytes[text_start..text_start + valid])
+                                .expect("valid_up_to must delimit valid UTF-8");
+                            performer.print_str(text);
+                            index = text_start + valid;
+                            continue;
+                        }
+                    } else {
+                        let text = core::str::from_utf8(&bytes[text_start..text_end])
+                            .expect("the UTF-8 slice was just validated");
+                        performer.print_str(text);
+                        index = text_end;
+                        continue;
+                    }
+                }
+            }
+
+            self.advance(performer, bytes[index]);
+            index += 1;
+        }
+    }
+
+    #[inline]
+    fn advance_numeric_csi<P: Perform>(
+        &mut self,
+        performer: &mut P,
+        bytes: &[u8],
+    ) -> Option<usize> {
+        if bytes.len() < 3 || !bytes.starts_with(b"\x1b[") {
+            return None;
+        }
+
+        let mut final_index = 2;
+        while final_index < bytes.len() {
+            match bytes[final_index] {
+                b'0'..=b'9' | b';' => final_index += 1,
+                0x40..=0x7e => break,
+                _ => return None,
+            }
+        }
+        if final_index == bytes.len() {
+            return None;
+        }
+
+        self.intermediate_idx = 0;
+        self.ignoring = false;
+        self.param = 0;
+        self.params.clear();
+        for byte in &bytes[2..final_index] {
+            if self.params.is_full() {
+                self.ignoring = true;
+                continue;
+            }
+            if *byte == b';' {
+                self.params.push(self.param);
+                self.param = 0;
+            } else {
+                self.param = self.param.saturating_mul(10);
+                self.param = self.param.saturating_add((*byte - b'0') as u16);
+            }
+        }
+        if self.params.is_full() {
+            self.ignoring = true;
+        } else {
+            self.params.push(self.param);
+        }
+        performer.csi_dispatch(self.params(), &[], self.ignoring, bytes[final_index] as char);
+        Some(final_index + 1)
+    }
