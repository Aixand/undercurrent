+    #[test]
+    fn bulk_processing_matches_scalar_terminal_state() {
+        let mut input = b"0123456789abcdefghijklmnopqrstuvwxyz".repeat(12);
+        input.extend_from_slice(b"\r\n\x1b[31mred\x1b[0m ");
+        input.extend_from_slice("界🙂e\u{301}".as_bytes());
+        input.extend_from_slice(b"\x1b]2;bulk title\x07");
+        input.extend_from_slice(&[0xf5, 0xff, b'!']);
+
+        let mut scalar = Parser::new(6, 17, 8);
+        for byte in &input {
+            scalar.parser.advance(&mut scalar.screen, *byte);
+        }
+
+        let mut bulk = Parser::new(6, 17, 8);
+        for chunk in input.chunks(7) {
+            bulk.process(chunk);
+        }
+
+        assert_eq!(bulk.screen().contents_formatted(), scalar.screen().contents_formatted());
+        assert_eq!(bulk.screen().title(), scalar.screen().title());
+        assert_eq!(bulk.screen().icon_name(), scalar.screen().icon_name());
+        assert_eq!(bulk.screen().errors(), scalar.screen().errors());
+    }
+
+    #[test]
+    fn repeated_three_column_glyph_falls_back_to_scalar_rendering() {
+        let text = "\u{17d8}";
+        let mut scalar = Parser::new(4, 20, 4);
+        let mut bulk = Parser::new(4, 20, 4);
+
+        for _ in 0..4 {
+            for byte in text.as_bytes() {
+                scalar.parser.advance(&mut scalar.screen, *byte);
+            }
+            bulk.process(text.as_bytes());
+        }
+
+        assert_eq!(bulk.screen().contents_formatted(), scalar.screen().contents_formatted());
+        assert_eq!(bulk.screen().cursor_position(), scalar.screen().cursor_position());
+        assert_eq!(bulk.screen().errors(), scalar.screen().errors());
+    }
+
+    #[test]
+    fn repeated_plain_unicode_and_controls_match_scalar_rendering() {
+        const TEXT: &str = "cacheable prompt: alpha beta \u{754c}\u{1f642}e\u{301}";
+        const CONTROL: &[u8] = b"\x1b[0m\r\n";
+        const FALLBACK: &str = "\u{17d8}\u{17d8}";
+
+        let mut scalar = Parser::new(40, 120, 0);
+        let mut bulk = Parser::new(40, 120, 0);
+        for iteration in 0..32_768 {
+            for bytes in [TEXT.as_bytes(), CONTROL] {
+                for byte in bytes {
+                    scalar.parser.advance(&mut scalar.screen, *byte);
+                }
+                bulk.process(bytes);
+            }
+            if iteration % 16 == 0 {
+                for byte in FALLBACK.as_bytes() {
+                    scalar.parser.advance(&mut scalar.screen, *byte);
+                }
+                bulk.process(FALLBACK.as_bytes());
+            }
