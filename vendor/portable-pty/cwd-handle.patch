+#[cfg(unix)]
+#[derive(Clone, Debug)]
+pub(crate) struct CwdHandle(pub std::sync::Arc<std::fs::File>);
+#[cfg(unix)]
+impl PartialEq for CwdHandle {
+    fn eq(&self, other: &Self) -> bool {
+        std::sync::Arc::ptr_eq(&self.0, &other.0)
+    }
+}
+#[cfg(all(unix, feature = "serde_support"))]
+fn serialize_cwd_handle<S: serde::Serializer>(
+    value: &Option<CwdHandle>,
+    serializer: S,
+) -> Result<S::Ok, S::Error> {
+    if value.is_some() {
+        return Err(serde::ser::Error::custom(
+            "directory handles cannot be serialized",
+        ));
+    }
+    serializer.serialize_none()
+}
