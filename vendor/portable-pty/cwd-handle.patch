+    /// Pin the child working directory independently of concurrent path replacement.
+    /// The handle is retained through fork and used before inherited descriptors close.
+    /// Only absolute executable paths are supported with a pinned directory.
+    #[cfg(unix)]
+    pub fn cwd_handle(&mut self, directory: std::sync::Arc<std::fs::File>) -> std::io::Result<()> {
+        if !directory.metadata()?.is_dir() {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "working directory handle is not a directory",
+            ));
+        }
+        self.cwd_handle = Some(CwdHandle(directory));
+        self.cwd = None;
+        Ok(())
     }
 
