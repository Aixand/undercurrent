Set Shell "bash"
Set Width 1440
Set Height 760
Set FontFamily "Noto Sans Mono"
Set FontSize 24
Set LineHeight 1.1
Set Padding 24
Set Margin 12
Set MarginFill "#07101f"
Set BorderRadius 12
Set WindowBar Colorful
Set CursorBlink false
Set Framerate 25
Set TypingSpeed 35ms
Set WaitTimeout 15s
Set Theme { "name": "Undercurrent", "black": "#142238", "red": "#ff7e8a", "green": "#83d9a1", "yellow": "#f4d17a", "blue": "#3da5ff", "magenta": "#bca2ff", "cyan": "#56d4ff", "white": "#dce9f5", "brightBlack": "#71869f", "brightRed": "#ff9ca6", "brightGreen": "#a8e6bc", "brightYellow": "#ffe1a0", "brightBlue": "#7abfff", "brightMagenta": "#d4bdff", "brightCyan": "#9ee8ff", "brightWhite": "#ffffff", "background": "#0b1628", "foreground": "#dce9f5", "selection": "#233b58", "cursor": "#56d4ff" }
