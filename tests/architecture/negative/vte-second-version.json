      "dependency": {
        "name": "vte",
        "version": "0.11.0",
        "source": "registry+https://github.com/rust-lang/crates.io-index",
        "path": null,
        "package_id": "registry+https://github.com/rust-lang/crates.io-index#vte@0.11.0"
      },
      "dependency_name": "vte-reference",
      "kind": "dev"
    }
  },
  "expected_rule": "ARCH_VTE_IDENTITY_MISMATCH"
}
